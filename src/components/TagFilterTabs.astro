---
import TagChip from './TagChip.astro';
import type { Tag } from '../lib/types';

interface Props {
  tags: Tag[];
}

const { tags } = Astro.props;
---

{/* The two views switch on the URL fragment, so no script runs on the page. */}
<div class="switch">
  <span class="anchor" id="all"></span>
  <span class="anchor" id="tags"></span>

  <div class="shell">
    <nav class="tabs" aria-label="Post views">
      <a class="tab tab--all" href="#all">All blogs</a>
      <a class="tab tab--tags" href="#tags">Tags</a>
    </nav>
  </div>

  <div class="panel panel--all">
    <slot />
  </div>

  <div class="panel panel--tags">
    <div class="shell">
      {
        tags.length > 0 ? (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <TagChip tag={tag} size="md" />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No tags yet. Add one in the Studio.</p>
        )
      }
    </div>
  </div>
</div>

<style>
  .switch {
    margin-top: var(--section-gap);
  }

  /* Zero-height scroll targets sitting where the tab row starts, so
     following a tab link lands on the tabs instead of the panel below. */
  .anchor {
    display: block;
    height: 0;
    scroll-margin-top: 4.5rem;
  }

  .tabs {
    display: flex;
    gap: 1.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .tab {
    position: relative;
    padding-bottom: 0.75rem;
    margin-bottom: -0.8rem;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .tab:hover {
    color: var(--ink-muted);
  }

  .tab::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: transparent;
  }

  .panel--all {
    display: block;
  }

  .panel--tags {
    display: none;
    padding-top: 2.5rem;
  }

  .switch:has(#tags:target) .panel--all {
    display: none;
  }

  .switch:has(#tags:target) .panel--tags {
    display: block;
  }

  /* Active tab: "All blogs" unless the tags view is targeted. */
  .tab--all,
  .switch:has(#tags:target) .tab--tags {
    color: var(--ink);
  }

  .tab--all::after,
  .switch:has(#tags:target) .tab--tags::after {
    background: var(--celadon);
  }

  .switch:has(#tags:target) .tab--all {
    color: var(--ink-faint);
  }

  .switch:has(#tags:target) .tab--all::after {
    background: transparent;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    margin: 0;
    color: var(--ink-faint);
  }
</style>
