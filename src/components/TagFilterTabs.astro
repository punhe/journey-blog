---
import TagChip from './TagChip.astro';
import type { Tag } from '../lib/types';

interface Props {
  tags: Tag[];
}

const { tags } = Astro.props;
---

{/* The two views switch on the URL fragment, so no script runs on the page. */}
<div class="switch">
  <span class="anchor" id="all"></span>
  <span class="anchor" id="tags"></span>

  <div class="page">
    <nav class="tabs" aria-label="Cách xem bài">
      <a class="tab tab--all" href="#all">Tất cả</a>
      <a class="tab tab--tags" href="#tags">Theo thẻ</a>
    </nav>
  </div>

  <div class="panel panel--all">
    <slot />
  </div>

  <div class="panel panel--tags">
    <div class="page">
      {
        tags.length > 0 ? (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <TagChip tag={tag} size="md" />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">Chưa có thẻ nào.</p>
        )
      }
    </div>
  </div>
</div>

<style>
  .switch {
    margin-top: var(--section-gap);
  }

  /* Zero-height scroll targets sitting where the tab row starts, so
     following a tab link lands on the tabs instead of the panel below. */
  .anchor {
    display: block;
    height: 0;
    scroll-margin-top: 4.5rem;
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--line);
  }

  .tab {
    position: relative;
    padding: 0.4rem 0.6rem 0.55rem;
    color: var(--text-3);
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--r-sm) var(--r-sm) 0 0;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  .tab:hover {
    color: var(--text-2);
    background: var(--bg-hover);
  }

  .tab::after {
    content: '';
    position: absolute;
    inset-inline: 0.15rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: transparent;
  }

  .panel--all {
    display: block;
  }

  .panel--tags {
    display: none;
    padding-top: 1.75rem;
  }

  .switch:has(#tags:target) .panel--all {
    display: none;
  }

  .switch:has(#tags:target) .panel--tags {
    display: block;
  }

  /* "Tất cả" is the active tab unless the tag view is targeted. */
  .tab--all,
  .switch:has(#tags:target) .tab--tags {
    color: var(--text);
  }

  .tab--all::after,
  .switch:has(#tags:target) .tab--tags::after {
    background: var(--accent);
  }

  .switch:has(#tags:target) .tab--all {
    color: var(--text-3);
  }

  .switch:has(#tags:target) .tab--all::after {
    background: transparent;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    margin: 0;
    color: var(--text-3);
  }
</style>
