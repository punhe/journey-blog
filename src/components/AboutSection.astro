---
import { imageFor } from '../lib/sanity';
import type { PortableTextNode, SanityImage } from '../lib/types';
import PortableText from './PortableText.astro';

interface Props {
  image?: SanityImage;
  body?: PortableTextNode[];
}

const { image, body } = Astro.props;
const portrait = imageFor(image)?.width(320).height(320).url();
const hasBody = Boolean(body?.length);
---

{
  (portrait || hasBody) && (
    <section class="about" aria-labelledby="about-heading">
      <div class="page about__inner">
        {portrait && (
          <img
            class="about__portrait"
            src={portrait}
            alt={image?.alt ?? ''}
            width="320"
            height="320"
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="about__body">
          <h2 class="about__heading" id="about-heading">
            Về người viết
          </h2>
          <PortableText value={body} />
        </div>
      </div>
    </section>
  )
}

<style>
  .about {
    margin-top: var(--section-gap);
    padding-top: var(--section-gap);
    border-top: 1px solid var(--line);
  }

  .about__inner {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  .about__portrait {
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    border-radius: var(--r-pill);
    background: var(--bg-soft);
  }

  .about__heading {
    margin: 0 0 0.6rem;
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .about__body :global(.prose) {
    font-size: var(--step-0);
    color: var(--text-2);
  }

  @media (min-width: 640px) {
    .about__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
