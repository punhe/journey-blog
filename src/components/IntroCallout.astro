---
interface Props {
  text?: string;
}

const { text } = Astro.props;
---

{
  text && (
    <div class="shell">
      <p class="callout">{text}</p>
    </div>
  )
}

<style>
  .callout {
    max-width: var(--measure);
    margin: 1.75rem 0 0;
    padding: 0.1rem 0 0.1rem 1.4rem;
    border-left: 2px solid var(--celadon);
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
