---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteTitle: string;
}

const { siteTitle } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<header class="bar">
  <div class="bar__inner">
    {
      isHome ? (
        <span class="mark">{siteTitle}</span>
      ) : (
        <a class="mark mark--link" href="/">
          {siteTitle}
        </a>
      )
    }
    <ThemeToggle />
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }

  /* The rule appears only once the page has moved under the bar. */
  @supports (animation-timeline: scroll()) {
    .bar {
      animation: bar-edge linear both;
      animation-timeline: scroll();
      animation-range: 0 64px;
    }
  }

  @keyframes bar-edge {
    to {
      border-bottom-color: var(--line);
    }
  }

  .bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 52px;
    width: min(100% - var(--gutter) * 2, 64rem);
    margin-inline: auto;
  }

  .mark {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .mark--link {
    padding: 0.2rem 0.45rem;
    margin-left: -0.45rem;
    border-radius: var(--r-sm);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .mark--link:hover {
    background: var(--bg-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      animation: none;
      border-bottom-color: var(--line);
    }
  }
</style>
