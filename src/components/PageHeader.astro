---
import { imageFor } from '../lib/sanity';
import type { SanityImage } from '../lib/types';

interface Props {
  cover?: SanityImage;
  /** Notion-style page icon. One character, chosen by the author. */
  icon?: string;
  title: string;
  eager?: boolean;
}

const { cover, icon, title, eager = false } = Astro.props;
const builder = imageFor(cover);
const src = builder?.width(1600).height(400).url();
const srcNarrow = builder?.width(800).height(320).url();
---

<header class:list={['head', !src && 'head--bare']}>
  {
    src && (
      <picture class="head__cover">
        <source media="(max-width: 700px)" srcset={srcNarrow} />
        <img
          src={src}
          alt={cover?.alt ?? ''}
          width="1600"
          height="400"
          fetchpriority={eager ? 'high' : 'auto'}
          loading={eager ? 'eager' : 'lazy'}
        />
      </picture>
    )
  }

  <div class="page head__body">
    {icon && <span class="head__icon" aria-hidden="true">{icon}</span>}
    <h1 class="head__title">{title}</h1>
    <slot />
  </div>
</header>

<style>
  .head {
    padding-top: 1.5rem;
  }

  .head__cover {
    display: block;
    width: min(100% - var(--gutter) * 2, 64rem);
    margin-inline: auto;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .head__cover img {
    width: 100%;
    aspect-ratio: 4 / 1;
    object-fit: cover;
    background: var(--bg-soft);
  }

  .head__body {
    padding-top: 1.25rem;
  }

  /* The icon sits half over the cover, the way a Notion page icon does. */
  .head__icon {
    display: block;
    margin-top: -3.25rem;
    margin-bottom: 0.5rem;
    font-size: 3rem;
    line-height: 1;
  }

  .head--bare .head__icon {
    margin-top: 0;
  }

  .head__title {
    margin: 0;
    font-size: var(--step-5);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  @media (max-width: 700px) {
    .head__cover img {
      aspect-ratio: 5 / 2;
    }

    .head__icon {
      margin-top: -2.5rem;
      font-size: 2.5rem;
    }
  }
</style>
