---
interface Props {
  text?: string;
}

const { text } = Astro.props;
---

{
  text && (
    <aside class="callout">
      <p>{text}</p>
    </aside>
  )
}

<style>
  .callout {
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--r-md);
    background: var(--accent-soft);
    border-left: 3px solid var(--accent-line);
  }

  .callout p {
    margin: 0;
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text);
  }
</style>
