---
import type { Tag } from '../lib/types';

interface Props {
  tag: Tag;
  /** `static` renders a label instead of a link (used inside list rows). */
  as?: 'link' | 'static';
  size?: 'sm' | 'md';
}

const { tag, as = 'link', size = 'sm' } = Astro.props;
---

{
  as === 'link' ? (
    <a class:list={['pill', `pill--${size}`]} data-color={tag.color} href={`/tags/${tag.slug}`}>
      {tag.name}
    </a>
  ) : (
    <span class:list={['pill', `pill--${size}`]} data-color={tag.color}>
      {tag.name}
    </span>
  )
}

<style>
  .pill {
    --fg: var(--tag-gray-fg);
    --wash: var(--tag-gray-bg);

    display: inline-block;
    padding: 0.1em 0.55em;
    border-radius: var(--r-sm);
    background: var(--wash);
    color: var(--fg);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.55;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill--md {
    padding: 0.28em 0.75em;
    font-size: var(--step-0);
  }

  a.pill {
    transition: filter 140ms ease;
  }

  a.pill:hover {
    filter: brightness(0.96) saturate(1.12);
  }

  :global([data-theme='dark']) a.pill:hover {
    filter: brightness(1.22);
  }

  .pill[data-color='blue'] {
    --fg: var(--tag-blue-fg);
    --wash: var(--tag-blue-bg);
  }
  .pill[data-color='green'] {
    --fg: var(--tag-green-fg);
    --wash: var(--tag-green-bg);
  }
  .pill[data-color='brown'] {
    --fg: var(--tag-brown-fg);
    --wash: var(--tag-brown-bg);
  }
  .pill[data-color='purple'] {
    --fg: var(--tag-purple-fg);
    --wash: var(--tag-purple-bg);
  }
  .pill[data-color='red'] {
    --fg: var(--tag-red-fg);
    --wash: var(--tag-red-bg);
  }
  .pill[data-color='gray'] {
    --fg: var(--tag-gray-fg);
    --wash: var(--tag-gray-bg);
  }
</style>
