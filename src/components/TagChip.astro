---
import type { Tag } from '../lib/types';

interface Props {
  tag: Tag;
  /** `static` renders a label instead of a link (used inside post cards). */
  as?: 'link' | 'static';
  size?: 'sm' | 'md';
}

const { tag, as = 'link', size = 'sm' } = Astro.props;
const label = [tag.emoji, tag.name].filter(Boolean).join(' ');
---

{
  as === 'link' ? (
    <a class:list={['chip', `chip--${size}`]} data-color={tag.color} href={`/tags/${tag.slug}`}>
      {label}
    </a>
  ) : (
    <span class:list={['chip', `chip--${size}`]} data-color={tag.color}>
      {label}
    </span>
  )
}

<style>
  .chip {
    --chip-ink: var(--tag-gray);

    display: inline-block;
    padding: 0.18em 0.62em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--chip-ink) 14%, transparent);
    color: var(--chip-ink);
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
  }

  .chip--md {
    padding: 0.3em 0.85em;
    font-size: var(--step-0);
  }

  a.chip {
    transition: background-color 160ms ease;
  }

  a.chip:hover {
    background: color-mix(in srgb, var(--chip-ink) 26%, transparent);
  }

  .chip[data-color='blue'] {
    --chip-ink: var(--tag-blue);
  }
  .chip[data-color='green'] {
    --chip-ink: var(--tag-green);
  }
  .chip[data-color='brown'] {
    --chip-ink: var(--tag-brown);
  }
  .chip[data-color='purple'] {
    --chip-ink: var(--tag-purple);
  }
  .chip[data-color='red'] {
    --chip-ink: var(--tag-red);
  }
  .chip[data-color='gray'] {
    --chip-ink: var(--tag-gray);
  }
</style>
