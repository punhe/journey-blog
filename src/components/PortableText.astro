---
import { bundledLanguages, codeToHtml } from 'shiki';
import { groupPortableText } from '../lib/portableText';
import { imageFor } from '../lib/sanity';
import type { PortableTextNode } from '../lib/types';
import BlockChildren from './BlockChildren.astro';

interface Props {
  value?: PortableTextNode[];
}

const { value } = Astro.props;
const items = groupPortableText(value);

/** Shiki has no GROQ grammar; JavaScript is close enough to read. */
const LANGUAGE_ALIASES: Record<string, string> = { groq: 'js', astro: 'html' };

function resolveLanguage(input: string | undefined): string {
  const name = (input ?? '').trim().toLowerCase();
  const aliased = LANGUAGE_ALIASES[name] ?? name;
  return aliased in bundledLanguages ? aliased : 'text';
}

/*
 * Highlighting happens here, at build time, so no highlighter ships to the
 * browser. Both themes are baked into CSS variables on every token, and the
 * stylesheet picks one, so a code block changes with the page theme without
 * a second request or a flash.
 */
const highlighted = new Map<string, string>();

await Promise.all(
  items.map(async (item) => {
    if (item.kind !== 'code' || !item.code.code) return;
    const html = await codeToHtml(item.code.code, {
      lang: resolveLanguage(item.code.language),
      themes: { light: 'github-light', dark: 'github-dark-dimmed' },
      defaultColor: false,
      cssVariablePrefix: '--tok-',
      transformers: [
        {
          // Drop Shiki's own background so the block sits on our surface.
          pre(node) {
            const style = String(node.properties.style ?? '');
            node.properties.style = style.replace(/--tok-[a-z]*-bg:[^;]*;?/g, '');
          },
        },
      ],
    });
    highlighted.set(item.code._key, html);
  }),
);
---

<div class="prose">
  {
    items.map((item) => {
      if (item.kind === 'list') {
        const List = item.listItem === 'number' ? 'ol' : 'ul';
        return (
          <List>
            {item.items.map((block) => (
              <li>
                <BlockChildren block={block} />
              </li>
            ))}
          </List>
        );
      }

      if (item.kind === 'code') {
        const html = highlighted.get(item.code._key);
        if (!html) return null;
        return (
          <div class="code">
            <button class="code__copy" type="button" data-copy>
              Chép
            </button>
            <Fragment set:html={html} />
          </div>
        );
      }

      if (item.kind === 'image') {
        const src = imageFor(item.image)?.width(1400).url();
        if (!src) return null;
        return (
          <figure>
            <img src={src} alt={item.image.alt ?? ''} loading="lazy" decoding="async" />
            {item.image.caption && <figcaption>{item.image.caption}</figcaption>}
          </figure>
        );
      }

      const { block } = item;
      if (block.style === 'h2') return <h2><BlockChildren block={block} /></h2>;
      if (block.style === 'h3') return <h3><BlockChildren block={block} /></h3>;
      if (block.style === 'blockquote') {
        return <blockquote><BlockChildren block={block} /></blockquote>;
      }
      return <p><BlockChildren block={block} /></p>;
    })
  }
</div>

<script>
  const RESET_AFTER = 1600;

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-copy]');
    if (button) {
      const code = button.parentElement?.querySelector('pre')?.textContent;
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Đã chép';
      } catch {
        // Clipboard blocked (insecure origin, or the reader said no).
        button.textContent = 'Bôi đen đi';
      }

      setTimeout(() => {
        button.textContent = 'Chép';
      }, RESET_AFTER);
    }
  });
</script>

<style>
  .prose {
    font-size: var(--step-1);
    line-height: 1.72;
    color: var(--text);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    max-width: var(--measure);
    margin-block: 0 1.15em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    max-width: var(--measure);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.018em;
  }

  .prose :global(h2) {
    margin-block: 2em 0.6em;
    font-size: var(--step-3);
  }

  .prose :global(h3) {
    margin-block: 1.7em 0.5em;
    font-size: var(--step-2);
  }

  .prose :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 140ms ease;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 0.1rem 0 0.1rem 1.1rem;
    border-left: 3px solid var(--line-strong);
    color: var(--text-2);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(li)::marker {
    color: var(--text-3);
  }

  .prose :global(figure) {
    margin: 2em 0;
  }

  .prose :global(figure img) {
    width: 100%;
    border-radius: var(--r-md);
  }

  .prose :global(figcaption) {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--text-3);
  }

  /* Inline code inside a sentence. */
  .prose :global(p code),
  .prose :global(li code) {
    padding: 0.12em 0.36em;
    border-radius: var(--r-sm);
    background: var(--bg-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.85em;
  }

  .code {
    position: relative;
    margin: 1.8em 0;
  }

  /* Prose sits at a reading measure, but code lines need more room, so the
     block steps outside the column once the viewport can spare it. */
  @media (min-width: 62rem) {
    .code {
      margin-inline: -3rem;
    }
  }

  .code :global(pre) {
    margin: 0;
    padding: 1.05rem 1.2rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg-sunken);
    font-family: var(--mono);
    font-size: var(--step--1);
    line-height: 1.7;
    tab-size: 2;
  }

  /* Shiki writes both themes onto every token; the page theme picks one. */
  .code :global(pre),
  .code :global(pre span) {
    color: var(--tok-light);
  }

  :global([data-theme='dark']) .code :global(pre),
  :global([data-theme='dark']) .code :global(pre span) {
    color: var(--tok-dark);
  }

  .code :global(pre:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .code__copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.2em 0.6em;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--text-3);
    font-family: inherit;
    font-size: var(--step--1);
    line-height: 1.6;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 140ms ease,
      color 140ms ease,
      border-color 140ms ease;
  }

  .code:hover .code__copy,
  .code__copy:focus-visible {
    opacity: 1;
  }

  .code__copy:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  /* Touch screens have no hover, so the button stays visible there. */
  @media (hover: none) {
    .code__copy {
      opacity: 1;
    }
  }
</style>
