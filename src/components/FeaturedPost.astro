---
import { formatDate, imageFor } from '../lib/sanity';
import type { PostSummary } from '../lib/types';
import TagChip from './TagChip.astro';
import ViewCount from './ViewCount.astro';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
const cover = imageFor(post.coverImage)?.width(760).height(480).url();
---

{/* The title link stretches over the whole block, so the tag pills below can
    stay real links without nesting anchors. */}
<article class="lead">
  {
    cover ? (
      <img
        class="lead__art"
        src={cover}
        alt={post.coverImage?.alt ?? ''}
        width="760"
        height="480"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <span class="lead__art lead__art--bare" aria-hidden="true">
        {post.emoji ?? ''}
      </span>
    )
  }

  <div class="lead__text">
    <h2 class="lead__title">
      <a class="lead__hit" href={`/posts/${post.slug}`}>{post.title}</a>
    </h2>

    {post.excerpt && <p class="lead__excerpt">{post.excerpt}</p>}

    <div class="lead__foot">
      {
        post.tags.length > 0 && (
          <ul class="lead__tags">
            {post.tags.map((tag) => (
              <li>
                <TagChip tag={tag} />
              </li>
            ))}
          </ul>
        )
      }
      <span class="lead__meta">
        {post.seriesNumber && <span class="lead__series">Kể chuyện #{post.seriesNumber}</span>}
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        <ViewCount slug={post.slug} />
      </span>
    </div>
  </div>
</article>

<style>
  .lead {
    position: relative;
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .lead::before {
    content: '';
    position: absolute;
    inset: -0.7rem;
    border-radius: var(--r-lg);
    background: transparent;
    transition: background-color 160ms ease;
  }

  .lead:hover::before {
    background: var(--bg-hover);
  }

  .lead__art {
    position: relative;
    width: 100%;
    aspect-ratio: 19 / 12;
    object-fit: cover;
    border-radius: var(--r-md);
    background: var(--bg-soft);
  }

  .lead__art--bare {
    display: grid;
    place-items: center;
    font-size: 2.5rem;
  }

  .lead__text {
    position: relative;
  }

  .lead__title {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.018em;
  }

  .lead__hit {
    text-decoration: none;
    color: inherit;
  }

  .lead__hit::after {
    content: '';
    position: absolute;
    inset: -0.7rem;
    border-radius: var(--r-lg);
  }

  .lead__excerpt {
    margin: 0.4rem 0 0;
    max-width: 32rem;
    color: var(--text-2);
    line-height: 1.6;
  }

  .lead__foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.9rem;
    margin-top: 0.8rem;
  }

  .lead__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step--1);
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .lead__series {
    color: var(--accent);
  }

  /* Side by side on wide screens, which also breaks the rhythm of the rows
     underneath. The overlay covers both columns. */
  @media (min-width: 720px) {
    .lead {
      grid-template-columns: 17rem minmax(0, 1fr);
      align-items: center;
      gap: 1.5rem;
    }

    .lead__hit::after {
      inset: -0.7rem;
      left: calc(-17rem - 2.2rem);
    }
  }
</style>
