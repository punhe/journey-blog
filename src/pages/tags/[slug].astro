---
import type { GetStaticPaths } from 'astro';
import PostList from '../../components/PostList.astro';
import TagChip from '../../components/TagChip.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, getSiteSettings, getTagBySlug } from '../../lib/sanity';

export const getStaticPaths = (async () => {
  const tags = await getAllTags();
  return tags.map((tag) => ({ params: { slug: tag.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const [tag, posts, settings] = await Promise.all([
  getTagBySlug(slug!),
  getPostsByTag(slug!),
  getSiteSettings(),
]);

if (!tag) {
  throw new Error(`No tag for slug "${slug}". The route list is out of date.`);
}

const count = `${posts.length} bài`;
---

<BaseLayout
  title={`${tag.name} | ${settings.title}`}
  description={`Các bài mang thẻ ${tag.name}.`}
  siteTitle={settings.title}
  width="wide"
>
  <div class="page crumbs">
    <a href="/#tags">Thẻ</a>
    <span aria-hidden="true">/</span>
    <span>{tag.name}</span>
  </div>

  <header class="page head">
    <h1 class="head__title">
      <TagChip tag={tag} as="static" size="md" />
    </h1>
    <p class="head__count">{count}</p>
  </header>

  <PostList posts={posts} emptyMessage="Chưa có bài nào mang thẻ này." />
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-top: 2rem;
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .crumbs a {
    padding: 0.2rem 0.4rem;
    margin-left: -0.4rem;
    border-radius: var(--r-sm);
    text-decoration: none;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .crumbs a:hover {
    background: var(--bg-hover);
    color: var(--text);
  }

  .head {
    padding-top: 0.6rem;
  }

  .head__title {
    margin: 0;
    font-size: var(--step-4);
    line-height: 1.2;
  }

  .head__count {
    margin: 0.5rem 0 0;
    font-size: var(--step--1);
    color: var(--text-3);
  }
</style>
