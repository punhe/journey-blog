---
import type { GetStaticPaths } from 'astro';
import PageHeader from '../../components/PageHeader.astro';
import PortableText from '../../components/PortableText.astro';
import TagChip from '../../components/TagChip.astro';
import ViewCount from '../../components/ViewCount.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toPlainText, truncate } from '../../lib/portableText';
import { formatDate, getAllPosts, getPostBySlug, getSiteSettings, imageFor } from '../../lib/sanity';

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const [post, settings] = await Promise.all([getPostBySlug(slug!), getSiteSettings()]);

if (!post) {
  throw new Error(`No published post for slug "${slug}". The route list is out of date.`);
}

const description = post.excerpt ?? truncate(toPlainText(post.body));
const social = imageFor(post.coverImage)?.width(1200).height(630).url() ?? null;
---

<BaseLayout
  title={`${post.title} | ${settings.title}`}
  description={description}
  siteTitle={settings.title}
  image={social}
>
  <article>
    <PageHeader cover={post.coverImage} icon={post.emoji} title={post.title} eager />

    <div class="page">
      {/* Notion shows a page's properties as label and value rows. */}
      <dl class="props">
        {
          post.tags.length > 0 && (
            <div class="props__row">
              <dt>Thẻ</dt>
              <dd>
                <ul class="props__tags">
                  {post.tags.map((tag) => (
                    <li>
                      <TagChip tag={tag} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        <div class="props__row">
          <dt>Ngày đăng</dt>
          <dd><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></dd>
        </div>
        {
          post.seriesNumber && (
            <div class="props__row">
              <dt>Kể chuyện</dt>
              <dd>Phần {post.seriesNumber}</dd>
            </div>
          )
        }
        <div class="props__row" data-views-row hidden>
          <dt>Lượt xem</dt>
          <dd><ViewCount slug={post.slug} increment /></dd>
        </div>
      </dl>

      <hr class="rule" />

      <PortableText value={post.body} />

      <p class="back"><a href="/">Quay lại trang chủ</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .props {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step-0);
  }

  .props__row[hidden] {
    display: none;
  }

  .props__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
  }

  .props dt {
    color: var(--text-3);
    font-weight: 500;
  }

  .props dd {
    margin: 0;
    color: var(--text-2);
  }

  .props__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rule {
    margin: 1.75rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .back {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--step-0);
  }

  .back a {
    display: inline-block;
    padding: 0.3rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: var(--r-sm);
    color: var(--text-2);
    text-decoration: none;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .back a:hover {
    background: var(--bg-hover);
    color: var(--text);
  }

  @media (max-width: 560px) {
    .props__row {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
  }
</style>
