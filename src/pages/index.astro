---
import AboutSection from '../components/AboutSection.astro';
import Callout from '../components/Callout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostList from '../components/PostList.astro';
import TagFilterTabs from '../components/TagFilterTabs.astro';
import PeekPanel from '../components/PeekPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, getAllTags, getSiteSettings, imageFor } from '../lib/sanity';

const [settings, posts, tags] = await Promise.all([
  getSiteSettings(),
  getAllPosts(),
  getAllTags(),
]);

const social = imageFor(settings.bannerImage)?.width(1200).height(630).url() ?? null;
---

<BaseLayout
  title={settings.title}
  description={settings.introCallout}
  siteTitle={settings.title}
  image={social}
  width="wide"
  authorName={settings.authorName}
>
  <PageHeader cover={settings.bannerImage} title={settings.title} eager>
    <Callout text={settings.introCallout} />
  </PageHeader>

  <TagFilterTabs tags={tags}>
    <PostList posts={posts} emptyMessage="Chưa có bài nào. Viết bài đầu tiên trong Studio." />
  </TagFilterTabs>

  <AboutSection image={settings.aboutImage} body={settings.aboutBody} />

  <PeekPanel />
</BaseLayout>
