---
import Header from '../components/Header.astro';
import '../styles/global.css';

export interface ArticleMeta {
  publishedAt: string;
  tags: string[];
  /** Plain text, used as the article body summary in structured data. */
  summary?: string;
}

interface Props {
  title: string;
  description?: string;
  siteTitle: string;
  /** Absolute Sanity image URL for the social preview. */
  image?: string | null;
  /** Index pages widen so the gallery grid lines up with the cover. */
  width?: 'reading' | 'wide';
  /** Present on a post page. Drives og:type, article meta and BlogPosting. */
  article?: ArticleMeta;
  authorName?: string;
}

const { title, description, siteTitle, image, width = 'reading', article, authorName } =
  Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const author = authorName || siteTitle;

/*
 * Structured data. Search engines use it for rich results, and assistants
 * quoting the page use it to attribute the answer, which is the whole point
 * of publishing here.
 */
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title.split(' | ')[0],
      description,
      datePublished: article.publishedAt,
      dateModified: article.publishedAt,
      inLanguage: 'vi-VN',
      keywords: article.tags.join(', ') || undefined,
      articleBody: article.summary,
      image: image ? [image] : undefined,
      author: { '@type': 'Person', name: author },
      publisher: { '@type': 'Person', name: author },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      url: canonical.href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: siteTitle,
      description,
      inLanguage: 'vi-VN',
      url: site.href,
      author: { '@type': 'Person', name: author },
    };
---

<!doctype html>
<html lang="vi" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content={author} />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    {
      article && (
        <Fragment>
          <meta property="article:published_time" content={article.publishedAt} />
          <meta property="article:author" content={author} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </Fragment>
      )
    }
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/* Resolve the theme before first paint so the page never flashes. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('journal-theme');
          var mode =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = mode;
          document.documentElement.style.colorScheme = mode;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a19" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Tới nội dung</a>
    <Header siteTitle={siteTitle} />
    <main id="main" data-width={width}>
      <slot />
    </main>
    <footer class="foot">
      <div class="page">
        <p>{siteTitle}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  main[data-width='wide'] {
    --page-w: 64rem;
  }

  .foot {
    margin-top: var(--section-gap);
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .foot p {
    margin: 0;
  }
</style>
