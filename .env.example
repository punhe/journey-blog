# Sanity project, from sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production

# Absolute site URL. Canonical tags, Open Graph, the sitemap and the feed are
# built from it. Leave it out to use the production URL in astro.config.mjs.
PUBLIC_SITE_URL=

# Editor token. Needed only by scripts/seed.ts and the Sanity MCP server.
# The site build does not use it: the dataset is public.
SANITY_API_TOKEN=
